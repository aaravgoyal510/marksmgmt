# ==============================================================================
# Database Configuration (PostgreSQL / Supabase)
# ==============================================================================

# Supabase Production / Serverless Pooler (Port 6543 via Supavisor)
# Required for serverless runtime queries with connection pooling.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Direct Connection (Port 5432)
# Required for Prisma migrations (prisma migrate deploy / prisma migrate dev) and CLI tasks.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].supabase.co:5432/postgres"

# --- Local PostgreSQL Alternative (comment out above and uncomment below for local dev) ---
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ia_portal?schema=public"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/ia_portal?schema=public"

# ==============================================================================
# Authentication & Security Secrets
# ==============================================================================

# Secret key used to sign and verify short-lived access JWT tokens (15m expiry).
# Generate using: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Secret key used to sign and verify long-lived refresh JWT tokens (7d expiry).
# Generate using: openssl rand -hex 32
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-long"

# Initial admin user password for seed scripts (e.g. prisma/seed.ts)
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction123!"

# ==============================================================================
# Email & External Services (Optional)
# ==============================================================================

# Resend API Key for sending transactional email notifications and query updates
RESEND_API_KEY="re_123456789"

# Sentry DSN for error monitoring and telemetry (optional)
SENTRY_DSN=""

# Supabase API credentials (if client-side Supabase features are enabled)
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# Base URL for public API (leave unset for relative /api routing)
# NEXT_PUBLIC_API_URL=""
