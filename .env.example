# ==============================================================================
# Database Configuration (PostgreSQL / Supabase)
# ==============================================================================

# Supabase Production / Serverless Pooler (Port 6543 via Supavisor) - REQUIRED
# Required for serverless runtime queries with connection pooling.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Direct Connection (Port 5432) - REQUIRED FOR MIGRATIONS
# Required for Prisma CLI tasks and migrations (prisma migrate deploy / prisma migrate diff).
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].supabase.co:5432/postgres"

# ==============================================================================
# Authentication & Security Secrets
# ==============================================================================

# Secret key used to sign and verify short-lived access JWT tokens (15m expiry) - REQUIRED
# Generate using: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Secret key used to sign and verify long-lived refresh JWT tokens (7d expiry) - REQUIRED
# Generate using: openssl rand -hex 32
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-long"

# Initial admin password for seed scripts (prisma/seed.ts and prisma/seed-prod.ts) - REQUIRED FOR SEEDING
# Must be min 12 chars with uppercase, lowercase, digit, and special char.
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction123!"

# Secret key to authorize automated cron executions (e.g. /api/cron/query-sla) - REQUIRED FOR SLA CRON
# Pass as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="your-super-secret-cron-secret-min-32-chars"

# Query SLA response threshold in hours (default: 48) - OPTIONAL
QUERY_SLA_HOURS="48"

# Safety flag for demo seeding (must be explicitly 'true' to allow running seed-demo.ts) - OPTIONAL
ALLOW_DEMO_SEED="false"

# ==============================================================================
# Email & External Services (Optional / Graceful Fallback)
# ==============================================================================

# Resend API Key for dispatching transactional email notifications - OPTIONAL
# When unset, email notifications are skipped gracefully with dev logging without throwing.
RESEND_API_KEY=""

# Sender email address used for outgoing institutional notifications - OPTIONAL
EMAIL_FROM="portal@bvimr.ac.in"

# SMTP host (alternative to Resend) - OPTIONAL
SMTP_HOST=""

# Sentry DSN for application monitoring and client CSP allowance - OPTIONAL
# When unset, Sentry instrumentation stays dormant and source maps are not uploaded.
SENTRY_DSN=""

# Sentry Auth Token for production source-map upload during build - OPTIONAL
SENTRY_AUTH_TOKEN=""
